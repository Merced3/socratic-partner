# Copy to .env and fill in local values. Never commit .env.

# Secret from Discord Developer Portal > Automation Lab > Bot.
DISCORD_BOT_TOKEN=

# Private deployment identifiers. Enable Developer Mode in Discord to copy IDs. Guild ID is the server ID, Channel ID is the channel to send messages to, and User ID is your personal user account ID, not the bot/application ID.
DISCORD_GUILD_ID=
DISCORD_TEST_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=

# Development safeguard. The first increment refuses to start unless this is true.
SOCRATIC_PARTNER_TEST_MODE=true

# Local operational state (the database file is ignored by Git).
SOCRATIC_PARTNER_DATABASE_PATH=data/socratic_partner.sqlite3
SOCRATIC_PARTNER_DEFAULT_INTERVAL_HOURS=24

# Pi RPC runtime. Leave PI_MODEL blank to use Pi's configured default model.
SOCRATIC_PARTNER_PI_EXECUTABLE=pi
SOCRATIC_PARTNER_PI_SESSION_DIRECTORY=data/pi-sessions
SOCRATIC_PARTNER_PI_MODEL=
SOCRATIC_PARTNER_PI_TIMEOUT_SECONDS=120

# Logging
SOCRATIC_PARTNER_LOG_LEVEL=INFO
