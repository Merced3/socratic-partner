# Copy to .env and fill in local values. Never commit .env.

# Secret from Discord Developer Portal > Automation Lab > Bot.
DISCORD_BOT_TOKEN=

# Private deployment identifiers. Enable Developer Mode in Discord to copy IDs.
DISCORD_GUILD_ID=
DISCORD_TEST_CHANNEL_ID=
DISCORD_ALLOWED_USER_ID=

# Development safeguard. The first increment refuses to start unless this is true.
SPARRING_PARTNER_TEST_MODE=true

# Logging
SPARRING_PARTNER_LOG_LEVEL=INFO
